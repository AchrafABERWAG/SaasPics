# Copier ce fichier en .env.local et remplir les valeurs.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez jamais de secret.

# URL publique du site (sans slash final), ex: https://www.mon-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : utilisé uniquement par les routes API (webhook Stripe, emails). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (emails transactionnels) — l'expéditeur doit utiliser un domaine vérifié
RESEND_API_KEY=
EMAIL_FROM="Lumina <bonjour@mon-domaine.com>"

# Adresse qui reçoit les candidatures partenaires (section Pro)
ADMIN_NOTIFICATION_EMAIL=

# Copier ce fichier en .env.local et remplir les valeurs.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez jamais de secret.

# URL publique du site (sans slash final), ex: https://www.mon-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : utilisé uniquement par les routes API (webhook Stripe, emails). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true une fois Stripe Tax configuré dans le Dashboard (TVA calculée automatiquement)
STRIPE_AUTOMATIC_TAX=false

# Resend (emails transactionnels) — l'expéditeur doit utiliser un domaine vérifié
RESEND_API_KEY=
EMAIL_FROM="Lumina <bonjour@mon-domaine.com>"

# Adresse qui reçoit les candidatures partenaires (section Pro)
ADMIN_NOTIFICATION_EMAIL=

# Envoi des emails : "resend" (production), "file" (écrit dans .outbox/ pour tester), "log" (console).
# Par défaut : resend si RESEND_API_KEY et EMAIL_FROM sont définis, sinon log.
EMAIL_TRANSPORT=

# Tâche quotidienne /api/cron/daily (emails "galerie prête" / "galerie bientôt fermée").
# Chaîne aléatoire longue ; Vercel Cron l'envoie automatiquement si elle est définie.
CRON_SECRET=
